# MongoDB Database Connection String
MONGODB_URI=mongodb://localhost:27017/elite_fitness

# Authentication Secret
JWT_SECRET=super_secret_jwt_key_elite_fitness_at_least_32_characters_long

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Brevo (Sendinblue) SMTP Configuration
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_login@example.com
BREVO_SMTP_PASS=your_brevo_smtp_master_password
BREVO_FROM_EMAIL=no-reply@elitefitness.et
BREVO_FROM_NAME="Elite Fitness Club"

# Chapa Payment Gateway Configuration
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_key

# Initial Administrator Credentials (used during seed/bootstrap)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@elitefitness.et
INITIAL_ADMIN_PASSWORD=AdminElite2026!
INITIAL_ADMIN_PHONE=+251911223344
